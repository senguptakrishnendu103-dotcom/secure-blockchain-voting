# ==========================================
# PUBLIC VARIABLES (Accessible by the Browser)
# ==========================================

# When deploying, paste your live backend URL here (e.g. https://your-backend.onrender.com/api)
# If left blank, it will automatically default to localhost for local testing
VITE_API_URL=

# Once you deploy the smart contract to Sepolia, paste the new contract address here
VITE_CONTRACT_ADDRESS=

# (Optional) If you want the frontend to read from the live blockchain instead of MetaMask injection
VITE_RPC_URL=

# ==========================================
# PRIVATE VARIABLES (Keep Secret!)
# ==========================================

# Your Alchemy or Infura RPC URL for the Sepolia Testnet
SEPOLIA_RPC_URL=

# Your MetaMask Private Key (NEVER commit this to GitHub!)
PRIVATE_KEY=
